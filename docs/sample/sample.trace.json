                  ]
                }
              ]
            },
            {
              "id": "s-3",
              "type": "sentence",
              "text": "TraceCite takes the same view of evidence: each claim is a block whose sources sit inside it (more in [the W3C spec](https://www.w3.org/TR/html401/intro/intro.html), and below in [the share of checked sentences](#/at/sec-share)).",
              "tags": [
                "role-interpretation",
                "support-none"
              ],
              "fields": [
                {
                  "key": "Sentence review",
                  "value": "Our reading of the two sources, labelled as interpretation."
                }
              ],
              "collapsed": false,
              "children": []
            }
          ]
        }
      ]
    },

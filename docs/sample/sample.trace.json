      "collapsed": false,
      "children": [
        {
          "id": "p-structure",
          "type": "paragraph",
          "text": "Why markup",
          "tags": [],
          "fields": [],
          "collapsed": false,
          "children": [
            {
              "id": "s-1",
              "type": "sentence",
              "text": "Markup languages were made to say what each part of a text is, not how it looks.",
              "tags": [
                "role-claim",
                "support-quoted",
                "topic-markup"
              ],
              "fields": [
                {
                  "key": "Sentence review",
                  "value": "The HTML 4.01 passage says SGML is for structural markup."
                }
              ],
              "collapsed": false,
              "children": [
                {
                  "id": "s-1-c",
                  "type": "citation",
                  "text": "raggett1999html",
                  "tags": [],
                  "fields": [
                    {
                      "key": "Source ID",
                      "value": "raggett1999html"
                    }
                  ],
                  "collapsed": true,
                  "children": [
                    {
                      "id": "s-1-c-r",
                      "type": "reference",
                      "text": "Exact reference",
                      "tags": [],
                      "fields": [
                        {
                          "key": "Source ID",
                          "value": "raggett1999html"
                        },
                        {
                          "key": "Exact supporting extract",
                          "value": "HTML has its roots in SGML which has always been a language for the specification of structural markup."
                        }
                      ],
                      "collapsed": true,
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "id": "s-2",
              "type": "sentence",
              "text": "Without such marks, a program sees only an undivided run of characters.",
              "tags": [
                "role-claim",
                "support-quoted",
                "topic-markup"
              ],
              "fields": [
                {
                  "key": "Sentence review",
                  "value": "Paraphrases the TEI passage; the quote is exact."
                }
              ],
              "collapsed": false,
              "children": [
                {
                  "id": "s-2-c",
                  "type": "citation",
                  "text": "tei2026guidelines",
                  "tags": [],
                  "fields": [
                    {
                      "key": "Source ID",
                      "value": "tei2026guidelines"
                    }
                  ],
                  "collapsed": true,
                  "children": [
                    {
                      "id": "s-2-c-r",
                      "type": "reference",
                      "text": "Exact reference",
                      "tags": [],
                      "fields": [
                        {
                          "key": "Source ID",
                          "value": "tei2026guidelines"
                        },
                        {
                          "key": "Exact supporting extract",
                          "value": "without them a digitized text appears to be nothing but a sequence of undifferentiated bits"
                        }
                      ],
                      "collapsed": true,
                      "children": []
                    }
                  ]
                },
                {
                  "id": "s-2-n",
                  "type": "note",
                  "text": "Could we quote the next sentence too, about the Web?",
